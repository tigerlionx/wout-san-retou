:"#d1d5db","lt":"CONTINUOUS","lw":0.25,"on":true,"lock":false,"h3d":0,"el3d":0,"wall":0},{"name":"STACK-MURS","color":"#ff6b5b","lt":"CONTINUOUS","lw":0.25,"on":true,"lock":false,"h3d":0,"el3d":0,"wall":0},{"name":"STACK-COTES","color":"#4ade80","lt":"CONTINUOUS","lw":0.25,"on":true,"lock":false,"h3d":0,"el3d":0,"wall":0},{"name":"STACK-EAU","color":"#38bdf8","lt":"CONTINUOUS","lw":0.25,"on":true,"lock":false,"h3d":0,"el3d":0,"wall":0},{"name":"STACK-VITRE","color":"#67e8f9","lt":"CONTINUOUS","lw":0.25,"on":true,"lock":false,"h3d":0,"el3d":0,"wall":0},{"name":"STACK-PROPOSITION","color":"#fb923c","lt":"CONTINUOUS","lw":0.25,"on":true,"lock":false,"h3d":0,"el3d":0,"wall":0},{"name":"STACK-ESCALIERS","color":"#a3e635","lt":"CONTINUOUS","lw":0.25,"on":true,"lock":false,"h3d":0,"el3d":0,"wall":0},{"name":"STACK-VERROU","color":"#ff2d55","lt":"CONTINUOUS","lw":0.25,"on":true,"lock":false,"h3d":0,"el3d":0,"wall":0},{"name":"STACK-HELICO","color":"#fb923c","lt":"CONTINUOUS","lw":0.25,"on":true,"lock":false,"h3d":0,"el3d":0,"wall":0},{"name":"VIEWPORTS","color":"#9aa3ad","lt":"CONTINUOUS","lw":0.25,"on":true,"lock":false,"h3d":0,"el3d":0,"wall":0},{"name":"CARTOUCHE","color":"#e6e9ee","lt":"CONTINUOUS","lw":0.25,"on":true,"lock":false,"h3d":0,"el3d":0,"wall":0}],"current":"0","blocks":{},"entities":[{"id":"1eu3v","type":"text","layer":"NOTES-TITRE","color":"BYLAYER","lt":"BYLAYER","lw":-1,"th":0,"el":0,"p":[-105000,34000],"h":1500,"rot":0,"text":"WOUT SAN RETOU: THE BUILDING","align":"left"},{"id":"284tz","type":"text","layer":"NOTES-TEXTE","color":"BYLAYER","lt":"BYLAYER","lw":-1,"th":0,"el":0,"p":[-105000,31600],"h":520,"rot":0,"text":"Drawn in OURCAD from the game code (src/level.rs ... level7.rs). Fictional place, fictional characters.","align":"left"},{"id":"3lc2q","type":"text","layer":"NOTES-TEXTE","color":"BYLAYER","lt":"BYLAYER","lw":-1,"th":0,"el":0,"p":[-105000,30000],"h":520,"rot":0,"text":"Review and change anything: tell Claude, and the game will be updated to match.","align":"left"},{"id":"4pbkz","type":"text","layer":"NOTES-TEXTE","color":"BYLAYER","lt":"BYLAYER","lw":-1,"th":0,"el":0,"p":[-105000,27500],"h":450,"rot":0,"text":"SHEETS: 1 Site and landscape | 2 Helicopter cockpit | 3 Ground floor A (maze, altar) | 4 Ground floor B (Madanm Flanm, pool)","align":"left"},{"id":"5mpuk","type":"text","layer":"NOTES-TEXTE","color":"BYLAYER","lt":"BYLAYER","lw":-1,"th":0,"el":0,"p":[-105000,26200],"h":450,"rot":0,"text":"5 First floor (Tet Woch, glass floor) | 6 Second floor (Zonbi Manchet, M50, reserve, altar hall) | 7 Third floor (Granmet Nwit) | 8 Roof | 9 Stair stack","align":"left"},{"id":"6mrff","type":"text","layer":"NOTES-TEXTE","color":"BYLAYER","lt":"BYLAYER","lw":-1,"th":0,"el":0,"p":[-105000,24200],"h":450,"rot":0,"text":"Scale: 1 drawing unit = 1 mm = 1 mm of real size. Game NORTH is up. Each floor has its own layers (SITE-*, GF1-*, GF2-*, F1-*, F2-*, F3-*, ROOF-*).","align":"left"},{"id":"71ejc","type":"text","layer":"NOTES-TEXTE","color":"BYLAYER","lt":"BYLAYER","lw":-1,"th":0,"el":0,"p":[-105000,22900],"h":450,"rot":0,"text":"Colours: red = SECRET passage panels and LOCKED stair doors | orange = PROPOSAL (new, not in the game yet) | yellow = objectives, arrivals | violet = guard patrols.","align":"left"},{"id":"8ueax","type":"table","layer":"NOTES-0","color":"BYLAYER","lt":"BYLAYER","lw":-1,"th":0,"el":0,"p":[-105000,20500],"h":420,"title":true,"cells":[["FLOORS AND GAME LEVELS","","",""],["FLOOR","GAME LEVEL","MAIN EVENT","STAIR UP (locked until)"],["Outdoor","Level 1","Sabotage truck, fuel, food; sniper; reach the house","House door (opens after the 3 sabotages)"],["Helicopter","NEW (before L1)","Hero in the cockpit launches the first strike","-"],["Ground A","Level 2","Maze, Nwit in secret panels, poison, 3-vial altar","Altar-room door (after the cure)"],["Ground B","Level 3","Madanm Flanm, ~50 Lost, pool, ballroom","NE stair room (Flanm down)"],["1st floor","Level 4","Tet Woch, ~120 Lost, glass floor over the pool","NE stair room (Tet Woch down)"],["2nd floor","Level 5","M50 armory, reserve room, altar hall, Zonbi Manchet","NE stair room (binding broken)"],["3rd floor","Level 6","Nwit quarters, bottle stash, hide and seek","NE stair room (Nwit flees)"],["Roof","Level 7","Final duel, four endings, helicopter","Walk away down the stairs"]],"colW":[4000,5000,18000,14000]},{"id":"9xmv1","type":"text","layer":"NOTES-PROPOSITION","color":"BYLAYER","lt":"BYLAYER","lw":-1,"th":0,"el":0,"p":[-105000,8800],"h":520,"rot":0,"text":"POINTS THAT DISAGREE BETWEEN THE GAME AND THE STORY (decide, then I update the game):","align":"left"},{"id":"axfu6","type":"text","layer":"NOTES-TEXTE","color":"BYLAYER","lt":"BYLAYER","lw":-1,"th":0,"el":0,"p":[-105000,7500],"h":440,"rot":0,"text":"1. Outside the house is a low 18 x 7 m building, but every floor inside is 60 x 40 m (the maze wing is 40 x 40). The exterior needs to grow to match.","align":"left"},{"id":"bfjk3","type":"text","layer":"NOTES-TEXTE","color":"BYLAYER","lt":"BYLAYER","lw":-1,"th":0,"el":0,"p":[-105000,6200],"h":440,"rot":0,"text":"2. SETTLED and in the game: the ground-floor pool is 18 x 24 m (x -9..9, z -12..12) right under the glass floor, in a central hall with walls at x +-12 (src/level3.rs and level4.rs updated; the game keeps a shallow wade zone, the 3D viewer shows it 3 m deep).","align":"left"},{"id":"ch6jd","type":"text","layer":"NOTES-TEXTE","color":"BYLAYER","lt":"BYLAYER","lw":-1,"th":0,"el":0,"p":[-105000,4900],"h":440,"rot":0,"text":"3. SETTLED and in the game: the stairs stack in the NE core (x 24..30, door at x 25.55) on every floor. The arrival points of Levels 4-6 (SW, SE, W) are not moved yet: a short walk from the stair top.","align":"left"},{"id":"dk6uk","type":"text","layer":"NOTES-TEXTE","color":"BYLAYER","lt":"BYLAYER","lw":-1,"th":0,"el":0,"p":[-105000,3600],"h":440,"rot":0,"text":"4. The 2nd floor maze is random in the game; the drawing shows one example. The Level 2 maze is fixed.","align":"left"},{"id":"ezgtj","type":"text","layer":"NOTES-TEXTE","color":"BYLAYER","lt":"BYLAYER","lw":-1,"th":0,"el":0,"p":[-105000,2300],"h":440,"rot":0,"text":"5. The cockpit and the helicopter strike do not exist in the game yet (PROPOSAL).","align":"left"},{"id":"fc9cy","type":"text","layer":"NOTES-TEXTE","color":"BYLAYER","lt":"BYLAYER","lw":-1,"th":0,"el":0,"p":[-105000,1000],"h":440,"rot":0,"text":"6. Your brief says two floors with Nwit: the game has one Nwit floor (3rd) plus the roof.","align":"left"},{"id":"gxmuh","type":"text","layer":"SITE-TITRE","color":"BYLAYER","lt":"BYLAYER","lw":-1,"th":0,"el":0,"p":[0,36000],"h":1300,"rot":0,"text":"SHEET 1: OUTDOOR LANDSCAPE (Level 1, The Night Before)","align":"center"},{"id":"hk08w","type":"text","layer":"SITE-TEXTE","color":"BYLAYER","lt":"BYLAYER","lw":-1,"th":0,"el":0,"p":[0,34100],"h":600,"rot":0,"text":"Compound 60 x 60 m, perimeter wall 0.6 m x 2.6 m. Hero starts at the south edge; the house is at the north end.","align":"center"},{"id":"ituc1","type":"hatch","layer":"SITE-AMENAGEMENT","color":"BYLAYER","lt":"BYLAYER","lw":-1,"th":0,"el":0,"loops":[[[-30000,30000],[30000,30000],[30000,-30000],[-30000,-30000]]],"pattern":"DOTS","scale":400,"angle":0,"alpha":0.1},{"id":"jxvhn","type":"hatch","layer":"SITE-AMENAGEMENT","color":"BYLAYER","lt":"BYLAYER","lw":-1,"th":0,"el":0,"loops":[[[-16000,5000],[24000,5000],[24000,-17000],[-16000,-17000]]],"pattern":"GRASS","scale":30,"angle":0,"alpha":0.35},{"id":"k276k","type":"text","layer":"SITE-AMENAGEMENT","color":"BYLAYER","lt":"BYLAYER","lw":-1,"th":0,"el":0,"p":[4000,-14800],"h":450,"rot":0,"text":"LAWN 40 x 22","align":"center"},{"id":"lwvg7","type":"wall","layer":"SITE-MURS","color":"BYLAYER","lt":"BYLAYER","lw":-1,"th":0,"el":0,"p1":[-30300,30300],"p2":[30300,30300],"w":600,"h":2800,"style":"Brique 200","just":"C","lv":"RDC"},{"id":"mlkgu","type":"wall","layer":"SITE-MURS","color":"BYLAYER","lt":"BYLAYER","lw":-1,"th":0,"el":0,"p1":[30300,30300],"p2":[30300,-30300],"w":600,"